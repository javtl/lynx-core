<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- ================================================================== -->
	<!-- ROOT POM — lynx-core                                                -->
	<!-- Packaging: pom (agregador, no produce JAR)                         -->
	<!-- ================================================================== -->
	<groupId>com.nominal.lynx</groupId>
	<artifactId>lynx-core</artifactId>
	<version>0.1.0-alpha</version>
	<packaging>pom</packaging>
	<name>LYNX Core 🐾 — Industrial Intelligence Engine</name>
	<description>Motor de trazabilidad inmutable para PYMES Biotecnológicas y Agroindustriales</description>

	<!-- ================================================================== -->
	<!-- MÓDULOS                                                              -->
	<!-- El orden importa: domain → application → infrastructure             -->
	<!-- ================================================================== -->
	<modules>
		<module>lynx-domain</module>
		<module>lynx-application</module>
		<module>lynx-infrastructure</module>
	</modules>

	<!-- ================================================================== -->
	<!-- PROPIEDADES GLOBALES                                                 -->
	<!-- ================================================================== -->
	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Versiones de dependencias gestionadas aquí, una sola vez -->
		<spring-boot.version>3.3.0</spring-boot.version>
		<lombok.version>1.18.32</lombok.version>
		<jakarta.validation.version>3.0.2</jakarta.validation.version>
		<junit.version>5.10.2</junit.version>
		<mockito.version>5.11.0</mockito.version>
		<jacoco.version>0.8.12</jacoco.version>
	</properties>

	<!-- ================================================================== -->
	<!-- DEPENDENCY MANAGEMENT                                                -->
	<!-- Centraliza versiones. Los módulos hijos declaran la dependencia     -->
	<!-- sin <version>; la hereda desde aquí.                                -->
	<!-- ================================================================== -->
	<dependencyManagement>
		<dependencies>

			<!-- Spring Boot BOM: importar como "pom" para heredar todas    -->
			<!-- las versiones gestionadas del ecosistema Spring.           -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Módulos internos de LYNX (sin <version> en los hijos)     -->
			<dependency>
				<groupId>com.nominal.lynx</groupId>
				<artifactId>lynx-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.nominal.lynx</groupId>
				<artifactId>lynx-application</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Lombok (compile-only en los hijos que lo necesiten)       -->
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>

			<!-- Jakarta Validation API (contratos de DTOs en application) -->
			<dependency>
				<groupId>jakarta.validation</groupId>
				<artifactId>jakarta.validation-api</artifactId>
				<version>${jakarta.validation.version}</version>
			</dependency>

			<!-- JUnit 5 (disponible en todos los módulos para testing)    -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-junit-jupiter</artifactId>
				<version>${mockito.version}</version>
				<scope>test</scope>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<!-- ================================================================== -->
	<!-- BUILD: Plugin Management global                                      -->
	<!-- ================================================================== -->
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
					<configuration>
						<source>17</source>
						<target>17</target>
						<encoding>UTF-8</encoding>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.2.5</version>
				</plugin>
				<!-- spring-boot-maven-plugin declarado aquí solo para     -->
				<!-- gestionar la versión; se ACTIVA solo en infrastructure -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring-boot.version}</version>
				</plugin>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>coverage-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
									<excludes>
										<exclude>com.nominal.lynx.LynxCoreApplication</exclude>
										<exclude>com.nominal.lynx.infrastructure.config.SecurityConfig</exclude>
										<exclude>com.nominal.lynx.infrastructure.input.rest.*</exclude>
										<exclude>com.nominal.lynx.infrastructure.output.ai.*</exclude>
										<exclude>com.nominal.lynx.infrastructure.output.security.*</exclude>
									</excludes>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>