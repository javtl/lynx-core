<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================== -->
    <!-- MÓDULO: lynx-infrastructure                                         -->
    <!-- El único módulo que conoce Spring Boot, MongoDB y el mundo real.   -->
    <!-- Contiene: Controllers REST, Repositorios MongoDB, Adaptadores de   -->
    <!--           IA (Claude), Adaptadores de n8n (Webhooks), Config de    -->
    <!--           Spring Security (JWT), Beans de configuración.           -->
    <!-- PRODUCE: El JAR ejecutable final con spring-boot-maven-plugin.     -->
    <!-- ================================================================== -->
    <parent>
        <groupId>com.nominal.lynx</groupId>
        <artifactId>lynx-core</artifactId>
        <version>0.1.0-alpha</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lynx-infrastructure</artifactId>
    <packaging>jar</packaging>
    <name>LYNX Infrastructure — Spring Boot Adapters &amp; Executable</name>

    <dependencies>

        <!-- ============================================================== -->
        <!-- DEPENDENCIA INTERNA: Application (que transitivamente trae     -->
        <!-- lynx-domain también)                                           -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>com.nominal.lynx</groupId>
            <artifactId>lynx-application</artifactId>
        </dependency>

        <!-- ============================================================== -->
        <!-- SPRING BOOT STARTERS                                            -->
        <!-- Versiones gestionadas por el BOM importado en el root pom.    -->
        <!-- ============================================================== -->

        <!-- API REST: Jackson + Tomcat embebido                            -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistencia MongoDB: MongoTemplate + Spring Data Repositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Seguridad: Spring Security base para la capa JWT              -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validación: Hibernate Validator (implementación Jakarta Val.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Swagger / OpenAPI 3 UI (springdoc)                            -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- JWT (jjwt): generación y validación de tokens                 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok (solo en infrastructure para reducir boilerplate en     -->
        <!-- Controllers y Config Beans — el Dominio no lo usa)            -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================== -->
        <!-- TESTING de Integración                                          -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers para levantar MongoDB real en tests             -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ========================================================== -->
            <!-- spring-boot-maven-plugin                                    -->
            <!-- Solo se activa AQUÍ. Empaqueta TODO el classpath           -->
            <!-- (incluyendo lynx-domain y lynx-application) en un único    -->
            <!-- Fat JAR ejecutable.                                         -->
            <!-- ========================================================== -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- version heredada del pluginManagement del root pom    -->
                <configuration>
                    <!-- Punto de entrada: la @SpringBootApplication        -->
                    <mainClass>com.nominal.lynx.LynxCoreApplication</mainClass>
                    <!-- Excluir Lombok del JAR final (es compile-only)    -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- Necesario para que Lombok funcione en compile  -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>